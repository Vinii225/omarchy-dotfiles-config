{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "crmne.mpris",
          "adaptiveLayout": true,
          "albumArtSize": 20,
          "showAlbumArt": true,
          "showArtist": true,
          "showControls": true,
          "maxCharacters": 50,
          "maxLabelWidth": 400
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "autoCheckUpdates": true,
          "id": "omaplug"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "io.github.alexmirkovic99-hue.system-stats",
          "palette": "system",
          "collapsed": false
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "bobbynicholas.omaland"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.battery"
  ]
}
