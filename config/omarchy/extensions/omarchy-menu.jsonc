{
// Style > Cursor submenu for io.github.smoothpixels.cursor-accent. Splice
// into ~/.config/omarchy/extensions/omarchy-menu.jsonc (see
// tools/install-menu-entries.sh).
  "style.cursor": {"icon":"","label":"Cursor","description":"Pick the accent-following cursor's colors and shape"},
  "style.cursor.follow": {"icon":"","label":"Follow Theme","checked":"[[ \"$($HOME/.config/omarchy/plugins/io.github.smoothpixels.cursor-accent/cursor-accent status | jq -r .mode)\" == \"theme\" ]]","action":"$HOME/.config/omarchy/plugins/io.github.smoothpixels.cursor-accent/cursor-accent follow"},
  "style.cursor.default": {"icon":"","label":"Default (System)","checked":"[[ \"$($HOME/.config/omarchy/plugins/io.github.smoothpixels.cursor-accent/cursor-accent status | jq -r .mode)\" == \"off\" ]]","action":"$HOME/.config/omarchy/plugins/io.github.smoothpixels.cursor-accent/cursor-accent default"},
  "style.cursor.modern": {"icon":"","label":"Modern (rounded)","checked":"[[ \"$($HOME/.config/omarchy/plugins/io.github.smoothpixels.cursor-accent/cursor-accent status | jq -r .shape)\" == \"modern\" ]]","action":"$HOME/.config/omarchy/plugins/io.github.smoothpixels.cursor-accent/cursor-accent shape modern"},
  "style.cursor.original": {"icon":"","label":"Original (sharp)","checked":"[[ \"$($HOME/.config/omarchy/plugins/io.github.smoothpixels.cursor-accent/cursor-accent status | jq -r .shape)\" == \"original\" ]]","action":"$HOME/.config/omarchy/plugins/io.github.smoothpixels.cursor-accent/cursor-accent shape original"},
  "style.cursor.fixed": {"icon":"","label":"Fixed Color…","checked":"[[ \"$($HOME/.config/omarchy/plugins/io.github.smoothpixels.cursor-accent/cursor-accent status | jq -r .mode)\" == \"fixed\" ]]","action":"omarchy-launch-floating-terminal-with-presentation '$HOME/.config/omarchy/plugins/io.github.smoothpixels.cursor-accent/tools/set-fixed-color.sh'"},
  // omaplug-menu-start
  "apps.omaplug": {"icon": "󱓖", "label": "Omaplug", "description": "Manage Omarchy plugins with Omaplug", "aliases": ["omaplug", "plugins"], "action": "omarchy-shell shell toggle omaplug", "when": "false"}
  // omaplug-menu-end

  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id, so
  // "personal.notes" appears under "personal", and "personal" appears on the
  // root menu. Reuse an existing id to override/extend it.
  //
  // Fields:
  //   icon        Nerd Font glyph shown in the icon column.
  //   label       Visible row title.
  //   action      Shell command to run. If omitted, the row is a submenu.
  //   target      Existing submenu id to open. Use for links/aliases.
  //   provider    Runtime provider function/command returning JSON rows.
  //   aliases     alternate `omarchy menu summon <name>` routes; also searchable.
  //   description Optional subtitle and extra search text.
  //   when        Shell condition; hide row when it fails.
  //   checked     Shell condition; append ✓ when it succeeds.
  //
  // Examples:
  // "personal": {"icon":"","label":"Personal"},
  // "personal.notes": {"icon":"󰎞","label":"Notes","action":"omarchy-launch-editor ~/notes"},
  // "personal.files": {"icon":"","label":"Files","action":"uwsm-app -- nautilus ~/Documents"},
  //
  // Only use provider when a provider_name function or command named "name"
  // returns JSON rows. Static submenus only need dotted ids.
  //
  // Example: replace the default About action by reusing the same id. Existing
  // fields are kept unless overridden.
  // "about": {"icon":"","label":"About","action":"omarchy-launch-or-focus-tui \"zsh -c 'fastfetch; read -k 1'\""},
}
